# kast-web test environment configuration
#
# This file is a template. On first run, scripts/test-env-up.sh copies it to
# .env.test (gitignored) and substitutes generated values for SECRET_KEY,
# ENCRYPTION_KEY, and TEST_ADMIN_PASSWORD. Edit .env.test afterwards if needed.

FLASK_ENV=development

# Generated on first run:
SECRET_KEY=__GENERATE__
ENCRYPTION_KEY=__GENERATE__

# Test database (isolated from prod at /var/lib/kast-web/kast.db)
DATABASE_URL=sqlite:////var/lib/kast-web-test/kast.db
KAST_CLI_PATH=/usr/local/bin/kast
KAST_RESULTS_DIR=/var/lib/kast-web-test/results

# Test Redis DB number (prod uses 0)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Test server
TEST_FLASK_PORT=8001
TEST_BASE_URL=http://127.0.0.1:8001

# Seeded admin (other users get created via the UI as a test case)
TEST_ADMIN_USERNAME=t_admin
TEST_ADMIN_EMAIL=t_admin@test.local
TEST_ADMIN_PASSWORD=__GENERATE__

# Throwaway scan targets (started by test-env-up.sh)
TEST_JUICESHOP_PORT=3000
TEST_WEBGOAT_PORT=8888
